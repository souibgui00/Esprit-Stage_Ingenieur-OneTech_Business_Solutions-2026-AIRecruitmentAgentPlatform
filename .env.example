# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@db:5432/recruitment_platform

# JWT Secret Key (used for token signing)
# Set this to a secure random string in production
SECRET_KEY=your_secret_key_here
# Alternative: JWT_SECRET_KEY (also supported for compatibility)

# Groq API Key for LLM operations (CV parsing, matching evaluation)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Override default model settings
# E5_MODEL_NAME=intfloat/multilingual-e5-large
# GROQ_MODEL=openai/gpt-oss-120b

# LinkedIn Job Sourcing Configuration
# LinkedIn connector uses public guest API (no authentication required)
LINKEDIN_ENABLED=true
LINKEDIN_MOCK_MODE=false
LINKEDIN_MAX_JOBS=25
LINKEDIN_PAGE_SIZE=25
LINKEDIN_REQUEST_TIMEOUT=10
LINKEDIN_REQUEST_DELAY=1.0
